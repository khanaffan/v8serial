{
  "name": "v8serial",
  "version": "1.0.0",
  "description": "V8 serialization-format reader and writer for C++ without linking V8",
  "license": "MIT",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "node-gyp rebuild",
    "pretest": "npm run build",
    "test": "node --test test/*.test.js",
    "probe": "node test/format_probe.js",
    "prebench": "npm run build",
    "bench": "node --expose-gc bench/bench.js",
    "bench:boundary": "npm run build --silent && node --expose-gc bench/boundary_bench.js",
    "bench:render": "node bench/bench.js --render-only"
  },
  "dependencies": {
    "node-addon-api": "8.9.2"
  },
  "devDependencies": {
    "node-gyp": "11.5.0"
  }
}
